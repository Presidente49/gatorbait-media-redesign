    "category": "ESSENTIAL",
    "html": "<style id=\"gbm-media-hub-v1\">\nhtml:has(#gbm-media-hub) #SITE_CONTAINER,html:has(#gbm-media-hub) #SITE_PAGES,html:has(#gbm-media-hub) #SITE_FOOTER{display:none!important;height:0!important;min-height:0!important;margin:0!important;padding:0!important;overflow:hidden!important}\nhtml:has(#gbm-media-hub) #SITE_CONTAINER,html:has(#gbm-media-hub) #masterPage,html:has(#gbm-media-hub) #PAGES_CONTAINER,html:has(#gbm-media-hub) #SITE_PAGES_TRANSITION_GROUP{height:auto!important;min-height:0!important;margin-bottom:0!important;padding-bottom:0!important}\n#gbm-media-hub,#gbm-media-hub *{box-sizing:border-box}\n#gbm-media-hub{background:#fffdf9;color:#11274a;font:15px/1.6 Barlow,sans-serif;padding:30px 24px 44px;position:relative;z-index:3}\n#gbm-media-hub .mh-wrap{max-width:1184px;margin:auto}\n#gbm-media-hub h1,#gbm-media-hub h2{font-family:\"Barlow Condensed\",Barlow,Arial,sans-serif;letter-spacing:-.025em;line-height:1.12}\n#gbm-media-hub h1{font-size:42px;margin:8px 0 16px}\n#gbm-media-hub h2{font-size:30px;margin:8px 0 16px}\n#gbm-media-hub .mh-kicker{color:#ba3c0c;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}\n#gbm-media-hub .mh-deck{max-width:64ch;color:#586475;margin-bottom:26px}\n#gbm-media-hub .mh-watch{display:grid;grid-template-columns:1.8fr 1fr;gap:30px;border-block:1px solid #ccd3dc;padding:26px 0}\n#gbm-media-hub .mh-player{aspect-ratio:16/9;background:#11274a;display:grid;place-items:center;color:#fff;min-width:0}\n#gbm-media-hub .mh-player iframe{width:100%;height:100%;border:0;aspect-ratio:16/9}\n#gbm-media-hub button,#gbm-media-hub .mh-button{font:700 14px/1.4 Barlow,sans-serif;cursor:pointer;border:0;min-height:48px;padding:14px 20px;background:#e84b10;color:#fff;display:inline-block;text-decoration:none}\n#gbm-media-hub a{color:inherit;text-underline-offset:4px}\n#gbm-media-hub a:focus-visible,#gbm-media-hub button:focus-visible{outline:3px solid #e84b10;outline-offset:4px}\n#gbm-media-hub .mh-links a{display:block;padding:10px 0;font-weight:700;font-size:14px}\n#gbm-media-hub .mh-programs{display:grid;grid-template-columns:1fr 1fr;gap:32px;padding-top:32px}\n#gbm-media-hub .mh-programs section{border-top:3px solid #e84b10;padding-top:18px}\n#gbm-media-hub .mh-programs p{color:#586475}\n#gbm-media-hub .mh-related{display:flex;gap:24px;flex-wrap:wrap;border-top:1px solid #ccd3dc;margin-top:32px;padding-top:20px;font-size:14px;font-weight:700}\n@media(max-width:820px){#gbm-media-hub{padding:22px 18px 30px}#gbm-media-hub h1{font-size:30px}#gbm-media-hub h2{font-size:25px}#gbm-media-hub .mh-watch,#gbm-media-hub .mh-programs{grid-template-columns:1fr;gap:22px}}\n#gbm-media-hub .mh-filmstrip{padding:22px 0;border-bottom:1px solid #ccd3dc}\n#gbm-media-hub .mh-strip-heading{display:flex;align-items:center;gap:20px;flex-wrap:wrap}\n#gbm-media-hub .mh-strip-heading h2{font-size:22px;margin:0 auto 0 0}\n#gbm-media-hub .mh-strip-heading button{font-size:13px;padding:10px 14px;min-height:44px}\n#gbm-media-hub .mh-strip-heading a{font-size:14px;font-weight:700}\n#gbm-media-hub .mh-player-note{font-size:13px;color:#586475;margin:12px 0}\n#gbm-media-hub .mh-strip{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x proximity;padding:4px 2px 14px}\n#gbm-media-hub .mh-video-card{flex:0 0 224px;scroll-snap-align:start;text-decoration:none}\n#gbm-media-hub .mh-video-card img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;background:#11274a}\n#gbm-media-hub .mh-video-card span{display:block;font-size:14px;line-height:1.4;font-weight:600;padding:9px 0}\n#gbm-media-hub .mh-video-card:hover span{text-decoration:underline}\n@media(max-width:600px){#gbm-media-hub .mh-video-card{flex-basis:72vw}}\n#gbm-media-hub .mh-card-visual{aspect-ratio:16/9;background:#11274a;border-bottom:3px solid #e84b10;display:grid;place-items:center}#gbm-media-hub .mh-card-visual [hidden]{display:none!important}#gbm-media-hub .mh-card-fallback{color:white;font-size:21px;padding:20px;text-align:center}#gbm-media-hub button.mh-video-card{background:transparent;color:#11274a;padding:0;border:0;text-align:left;white-space:normal;min-height:0;font:inherit}</style>\n<script>(function(){\n'use strict';if(window.__GBM_MEDIA_HUB__)return;window.__GBM_MEDIA_HUB__=1;\nfunction sync(){var on=/^\\/the-buddy-martin-show\\/?$/.test(location.pathname),old=document.getElementById('gbm-media-hub');if(!on){if(old)old.remove();return}if(old||!document.body)return;\nvar m=document.createElement('main');m.id='gbm-media-hub';m.innerHTML='<div class=\"mh-wrap\"><p class=\"mh-kicker\">GatorBait TV</p><h1>The conversation continues here.</h1><p class=\"mh-deck\">The Buddy Martin Show, Florida Gator Lowdown and GatorBait voices. Watch the shows and explore the conversations behind the reporting.</p><section class=\"mh-watch\"><div class=\"mh-player\"><button type=\"button\" id=\"gbm-load-episodes\">▶ Load the episode player</button></div><div><p class=\"mh-kicker\">The Buddy Martin Show</p><h2>Gators. Guests. Perspective.</h2><p>Full broadcasts and interviews from Buddy Martin and the GatorBait team.</p><p class=\"mh-schedule\"><strong>Regular showtimes</strong><br>Buddy: Monday, Wednesday and Thursday at 9 p.m. ET.<br>Lowdown: Tuesday at 9 p.m. ET.</p><p>Check the live broadcast for today’s status. Watch previous shows between broadcasts.</p><div class=\"mh-links\"><a href=\"https://www.youtube.com/@thebuddymartinshow/videos\" target=\"_blank\" rel=\"noopener\">Browse full shows on YouTube →</a><a href=\"https://www.youtube.com/@thebuddymartinshow/live\" target=\"_blank\" rel=\"noopener\">Check the live broadcast →</a><a href=\"https://www.youtube.com/@thebuddymartinshow/shorts\" target=\"_blank\" rel=\"noopener\">Watch clips →</a></div></div></section><div class=\"mh-programs\"><section><p class=\"mh-kicker\">Florida Gator Lowdown</p><h2>With Loren Meadows</h2><p>Football analysis and Gator conversation from the Lowdown team.</p><a href=\"https://www.youtube.com/@thebuddymartinshow/videos\" target=\"_blank\" rel=\"noopener\">Explore the show archive →</a></section><section id=\"podcasts\"><p class=\"mh-kicker\">Podcasts & conversations</p><h2>Watch the latest. Listen to the archive.</h2><p>Current broadcasts and video playlists are on YouTube. The Apple Podcasts archive contains older audio episodes.</p><div class=\"mh-links\"><a href=\"https://www.youtube.com/@thebuddymartinshow/playlists\" target=\"_blank\" rel=\"noopener\">Video playlists on YouTube →</a><a href=\"https://podcasts.apple.com/us/podcast/the-buddy-martin-show/id1321645302\" target=\"_blank\" rel=\"noopener\">Audio archive on Apple Podcasts →</a></div></section></div><nav class=\"mh-related\" aria-label=\"Keep exploring\"><a href=\"/gatorbait-media-blogs\">Latest stories →</a><a href=\"/magazine\">GatorBait Magazine →</a><a href=\"/pricing-plans\">Membership →</a><a href=\"/contact\">Contact the newsroom →</a></nav></div>';\nvar anchor=document.getElementById('gbm-mobile-shell-host')||document.getElementById('gbm-site-header');if(anchor&&anchor.parentNode===document.body)document.body.insertBefore(m,anchor.nextSibling);else document.body.insertBefore(m,document.body.firstChild);\nvar player=m.querySelector('.mh-player');\nfunction loadVideo(id,title,muted){\n var f=document.createElement('iframe');\n f.src='https://www.youtube.com/embed/'+(id||'videoseries?list=UUtR8b1sKFuwaRjKy5BiXRvA')+(id?'?':'&')+'autoplay=1&mute='+(muted?'1':'0')+'&playsinline=1&rel=0';\n f.title=title;\n var label=m.querySelector('.mh-selection');if(label)label.textContent=id?'Selected broadcast: '+title:'Latest broadcast playlist · Check the live link for current live status';\n f.allow='autoplay; encrypted-media; picture-in-picture; fullscreen';\n f.referrerPolicy='strict-origin-when-cross-origin';\n f.allowFullscreen=true;\n player.replaceChildren(f);\n}\nvar selection=document.createElement('p');selection.className='mh-selection mh-player-note';selection.setAttribute('role','status');m.querySelector('.mh-links').before(selection);\nloadVideo('', 'The Buddy Martin Show — latest broadcast', false);\nvar strip=document.createElement('section');\nstrip.className='mh-filmstrip';\nstrip.setAttribute('aria-label','Browse selected broadcasts');\nstrip.innerHTML='<div class=\"mh-strip-heading\"><h2>Selected shows</h2><button type=\"button\" class=\"mh-return\">Return to latest show</button><a href=\"https://www.youtube.com/@thebuddymartinshow/shorts\" target=\"_blank\" rel=\"noopener\">Browse Shorts →</a></div><p class=\"mh-player-note\">Watch with sound. If your browser pauses automatic playback, tap Play. The player opens the latest broadcast playlist. Swipe below for selected shows, including earlier previews.</p><div class=\"mh-strip\" tabindex=\"0\" aria-label=\"Selected shows, scroll horizontally\"></div>';\nvar videos=[\n ['qWBazfq_4Mc',\"Meltdown Monday: Florida’s 52-28 Statement Win + Shane Matthews\"],\n ['u2dMQ4u3yNY','Ole Miss vs Florida Preview Can the Gators Own the Swamp'],\n ['s9UU8a0wC7s','Does The Swamp Know Something the Big Ten Doesn’t?'],\n ['8aOQqgnVr7o','Would You Lay The 3.5 Points And Take Florida?'],\n ['sctBnF9Om7c','No. 21 Florida vs No. 4 Ole Miss Preview'],\n ['u1qAJBKZW7E','Are These Handicappers On Drugs?']\n];\nvideos.forEach(function(v){\n var a=document.createElement('button');a.type='button';\n a.className='mh-video-card';\n var img=document.createElement('img');\n img.src='https://i.ytimg.com/vi/'+v[0]+'/hqdefault.jpg';\n img.alt='';\n img.width=320;img.height=180;img.loading='lazy';\n var label=document.createElement('span');label.textContent=v[1];\n var visual=document.createElement('div');visual.className='mh-card-visual';var fallback=document.createElement('span');fallback.className='mh-card-fallback';fallback.textContent='▶ GatorBait TV';fallback.hidden=true;img.onerror=function(){img.hidden=true;fallback.hidden=false;};visual.append(img,fallback);a.append(visual,label);\n a.addEventListener('click',function(ev){if(ev.ctrlKey||ev.metaKey||ev.shiftKey||ev.altKey)return;ev.preventDefault();loadVideo(v[0],v[1],false);player.scrollIntoView({behavior:'smooth',block:'center'});});\n strip.querySelector('.mh-strip').appendChild(a);\n});\nstrip.querySelector('.mh-return').addEventListener('click',function(){loadVideo('','The Buddy Martin Show — latest broadcast',false);player.scrollIntoView({behavior:'smooth',block:'center'});});\nm.querySelector('.mh-watch').after(strip);\n}\nfunction schedule(){[0,250,900,1800].forEach(function(ms){setTimeout(sync,ms);});}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',schedule,{once:true});else schedule();window.addEventListener('popstate',schedule);window.addEventListener('gbmroutechange',schedule);\n})();</script>\n"

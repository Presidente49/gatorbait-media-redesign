    <!-- Stat leaders -->
    <mj-section background-color="#FFFDF9" padding="26px 26px 6px">
      <mj-column>
        <mj-text color="#081B35" font-size="25px" font-weight="800" padding="0 0 5px">STAT LEADERS</mj-text>
        <mj-divider border-color="#081B35" border-width="2px" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFDF9" padding="8px 16px 24px">
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="kicker" color="#003B7A" padding="10px 0 6px">FLORIDA</mj-text>
        <mj-text font-size="14px" line-height="1.5" padding="0">
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">PASSING</span><br/>
          <b>Aaron Philo</b> 16-23, 196 yds, 1 TD, 0 INT<br/>
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">RUSHING</span><br/>
          <b>Jadan Baugh</b> 29-142, 3 TD<br/>
          <b>Duke Clark</b> 12-126, 1 TD (long 45)<br/>
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">RECEIVING</span><br/>
          <b>Eric Singleton Jr.</b> 1-38<br/>
          <b>Bailey Stockton</b> 4-33<br/>
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">TACKLES</span><br/>
          <b>Myles Graham</b> 8, fumble recovery<br/>
          <b>Aaron Chiles</b> 7, 1 TFL<br/>
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">TAKEAWAYS &amp; RETURNS</span><br/>
          <b>DJ Coleman</b> 1 INT<br/>
          <b>London Montgomery</b> 3 KR, 128 yds (long 74)
        </mj-text>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="kicker" color="#6D7888" padding="10px 0 6px">OLE MISS</mj-text>
        <mj-text font-size="14px" line-height="1.5" padding="0">
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">PASSING</span><br/>
          <b>Trinidad Chambliss</b> 25-34, 298 yds, 1 TD, 1 INT<br/>
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">RUSHING</span><br/>
          <b>Trinidad Chambliss</b> 7-44, 2 TD<br/>
          <b>Makhi Frazier</b> 8-42<br/>
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">RECEIVING</span><br/>
          <b>Deuce Alexander</b> 7-134, 1 TD (long 49)<br/>
          <b>Caleb Odom</b> 5-47<br/>
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">TACKLES</span><br/>
          <b>Keaton Thomas</b> 11<br/>
          <b>Luke Ferrelli</b> 8<br/>
          <span style="color:#6D7888;font-size:10px;font-weight:800;letter-spacing:1px;">KICKING</span><br/>
          <b>Lucas Carneiro</b> 2-2 FG (long 46)
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Scoring summary -->
    <mj-section background-color="#FFFFFF" padding="26px 26px 6px">
      <mj-column>
        <mj-text color="#081B35" font-size="25px" font-weight="800" padding="0 0 5px">SCORING SUMMARY</mj-text>
        <mj-divider border-color="#FA4616" border-width="3px" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="8px 26px 24px">
      <mj-column>
        <mj-table width="100%" padding="0" font-size="13px">
          <tr style="border-bottom:2px solid #081B35;font-size:10px;font-weight:800;letter-spacing:1px;color:#6D7888;">
            <th style="text-align:left;padding:5px 4px;width:22%;">Q · TIME</th>
            <th style="text-align:left;padding:5px 4px;">PLAY</th>
            <th style="text-align:right;padding:5px 4px;width:17%;">FLA-MISS</th>
          </tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">1 · 10:53</td><td style="padding:7px 4px;"><b style="color:#003B7A;">FLA</b> Baugh 4 run (Durkin kick)</td><td style="text-align:right;padding:7px 4px;font-weight:700;">7-0</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">1 · 9:00</td><td style="padding:7px 4px;"><b style="color:#003B7A;">FLA</b> Durkin 49 FG</td><td style="text-align:right;padding:7px 4px;font-weight:700;">10-0</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">2 · 10:13</td><td style="padding:7px 4px;"><b style="color:#6D7888;">MISS</b> Carneiro 36 FG</td><td style="text-align:right;padding:7px 4px;font-weight:700;">10-3</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">2 · 2:51</td><td style="padding:7px 4px;"><b style="color:#003B7A;">FLA</b> Baugh 2 run (Durkin kick)</td><td style="text-align:right;padding:7px 4px;font-weight:700;">17-3</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">2 · 1:11</td><td style="padding:7px 4px;"><b style="color:#6D7888;">MISS</b> Carneiro 46 FG</td><td style="text-align:right;padding:7px 4px;font-weight:700;">17-6</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">3 · 13:03</td><td style="padding:7px 4px;"><b style="color:#6D7888;">MISS</b> Chambliss 8 run (Chambliss to Fields, 2-pt)</td><td style="text-align:right;padding:7px 4px;font-weight:700;">17-14</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">3 · 11:32</td><td style="padding:7px 4px;"><b style="color:#003B7A;">FLA</b> Clark 45 run (Durkin kick)</td><td style="text-align:right;padding:7px 4px;font-weight:700;">24-14</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">3 · 5:21</td><td style="padding:7px 4px;"><b style="color:#6D7888;">MISS</b> Chambliss 10 run (Carneiro kick)</td><td style="text-align:right;padding:7px 4px;font-weight:700;">24-21</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">3 · 3:45</td><td style="padding:7px 4px;"><b style="color:#003B7A;">FLA</b> Philo 1 run (Durkin kick)</td><td style="text-align:right;padding:7px 4px;font-weight:700;">31-21</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">4 · 13:38</td><td style="padding:7px 4px;"><b style="color:#003B7A;">FLA</b> Wilson 6 run (Durkin kick)</td><td style="text-align:right;padding:7px 4px;font-weight:700;">38-21</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">4 · 12:09</td><td style="padding:7px 4px;"><b style="color:#6D7888;">MISS</b> Alexander 2 pass from Chambliss (Carneiro kick)</td><td style="text-align:right;padding:7px 4px;font-weight:700;">38-28</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:7px 4px;color:#6D7888;">4 · 9:19</td><td style="padding:7px 4px;"><b style="color:#003B7A;">FLA</b> Jackson 5 pass from Philo (Durkin kick)</td><td style="text-align:right;padding:7px 4px;font-weight:700;">45-28</td></tr>
          <tr><td style="padding:7px 4px;color:#6D7888;">4 · 4:00</td><td style="padding:7px 4px;"><b style="color:#003B7A;">FLA</b> Baugh 2 run (Durkin kick)</td><td style="text-align:right;padding:7px 4px;font-weight:900;color:#FA4616;">52-28</td></tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- By the numbers -->
    <mj-section background-color="#081B35" padding="26px 26px 6px">
      <mj-column>
        <mj-text color="#FFFFFF" font-size="25px" font-weight="800" padding="0 0 5px">BY THE NUMBERS</mj-text>
        <mj-divider border-color="#FA4616" border-width="3px" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#081B35" padding="10px 16px 0">
      <mj-column width="50%" padding="0 10px">
        <mj-text color="#D5DFEC" font-size="14px" padding="10px 0 14px"><span class="gb-num">302</span><br/>Florida rushing yards on 53 carries. Ole Miss ran for 128.</mj-text>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text color="#D5DFEC" font-size="14px" padding="10px 0 14px"><span class="gb-num">2</span><br/>100-yard rushers: Jadan Baugh (142) and Duke Clark (126, 10.5 per carry).</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#081B35" padding="0 16px">
      <mj-column width="50%" padding="0 10px">
        <mj-text color="#D5DFEC" font-size="14px" padding="10px 0 14px"><span class="gb-num">5</span><br/>Straight second-half possessions ending in Florida touchdowns.</mj-text>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text color="#D5DFEC" font-size="14px" padding="10px 0 14px"><span class="gb-num">+2</span><br/>Turnover margin. Florida gave it away zero times; Woods’ strip-sack and Coleman’s INT took it back twice.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#081B35" padding="0 16px 26px">
      <mj-column width="50%" padding="0 10px">
        <mj-text color="#D5DFEC" font-size="14px" padding="10px 0 14px"><span class="gb-num">128</span><br/>Kick return yards for London Montgomery on three returns, including 41 and 74.</mj-text>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text color="#D5DFEC" font-size="14px" padding="10px 0 14px"><span class="gb-num">15</span><br/>Plays on the 87-yard, seven-minute second-quarter drive that ended in Baugh’s second TD, as cited at UF’s postgame presser.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#081B35" padding="0 26px 24px">
      <mj-column>
        <mj-text color="#9EADC1" font-size="12px" line-height="1.5" padding="0">
          Also: Florida’s first win over a top-five team since 2020 (per The Alligator and CBS Sports). The early tone-setter was Aaron Chiles’ fourth-and-1 stop in the first quarter.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- They said -->
    <mj-section background-color="#FFFFFF" padding="26px 26px 6px">
      <mj-column>
        <mj-text color="#081B35" font-size="25px" font-weight="800" padding="0 0 5px">THEY SAID</mj-text>
        <mj-divider border-color="#081B35" border-width="2px" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="8px 26px 6px">
      <mj-column border-left="3px solid #FA4616" padding="0 0 0 14px">
        <mj-text padding="6px 0 4px"><span class="gb-h3">“It’s not sleep. But it ain’t fully awake yet.”</span></mj-text>
        <mj-text mj-class="meta" padding="0 0 14px">Jon Sumrall, on his program</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="6px 26px 6px">
      <mj-column border-left="3px solid #FA4616" padding="0 0 0 14px">
        <mj-text padding="6px 0 4px"><span class="gb-h3">“I feel that no defense in the country could stop us from putting up points.”</span></mj-text>
        <mj-text mj-class="meta" padding="0 0 14px">Jadan Baugh</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="6px 26px 24px">
      <mj-column border-left="3px solid #FA4616" padding="0 0 0 14px">
        <mj-text padding="6px 0 4px"><span class="gb-h3">“I saw he was right there and his eyes were downfield, and first instinct is to go for the ball.”</span></mj-text>
        <mj-text mj-class="meta" padding="0 0 14px">Jayden Woods, on his strip-sack of Chambliss</mj-text>
        <mj-text color="#748195" font-size="10px" padding="0">Quotes from UF’s official ASAP Sports postgame transcripts.</mj-text>
      </mj-column>
    </mj-section>


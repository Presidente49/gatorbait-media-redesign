<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Florida 34, Vanderbilt 27: The GatorBait Postgame Magazine</mj-title>
    <mj-preview>The game story, Buddy Martin, Franz Beard and Eddie Gilley on the win, 126 photos from Chris Spears, the box score and a PDF for your phone.</mj-preview>
    <mj-font name="Barlow" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Barlow, Arial, Helvetica, sans-serif" />
      <mj-text color="#14243D" font-size="16px" line-height="1.5" />
      <mj-button background-color="#FA4616" color="#FFFFFF" border-radius="0" inner-padding="16px 30px" font-size="16px" font-weight="800" letter-spacing="1px" />
    </mj-attributes>
    <mj-style>
      :root { color-scheme: light; supported-color-schemes: light; }
      .gz-credit { font-style: italic; }
      @media only screen and (max-width: 480px) {
        .gz-wordmark { font-size: 38px !important; }
        .gz-headline { font-size: 30px !important; line-height: 1.08 !important; }
        .gz-pad { padding-left: 18px !important; padding-right: 18px !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#E9EDF3" width="600px">
    <mj-section background-color="#040E1E" padding="7px 22px" css-class="gz-pad">
      <mj-group>
        <mj-column width="58%" padding="0">
          <mj-text padding="0" color="#C9D4E4" font-size="11px" font-weight="700" letter-spacing="1.4px" line-height="1.4">SUNDAY, NOV. 22, 2026</mj-text>
        </mj-column>
        <mj-column width="42%" padding="0">
          <mj-text padding="0" align="right" color="#FA7A45" font-size="11px" font-weight="800" letter-spacing="1.4px" line-height="1.4">POSTGAME MAGAZINE</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#081B35" padding="24px 22px 6px" css-class="gz-pad">
      <mj-column>
        <mj-text align="center" padding="0" color="#FFFFFF" font-size="46px" font-weight="800" letter-spacing="1px" line-height="1" css-class="gz-wordmark">GATOR<span style="color:#FA4616;">BAIT</span></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#081B35" padding="0 22px 4px" css-class="gz-pad">
      <mj-column>
        <mj-divider border-color="#FA4616" border-width="3px" padding="8px 0 0" />
        <mj-text align="center" padding="8px 0 2px" color="#FFFFFF" font-size="15px" font-weight="800" letter-spacing="9px" line-height="1.2">THE GAZETTE</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#081B35" padding="0 22px 16px" css-class="gz-pad">
      <mj-column>
        <mj-divider border-color="#5E7396" border-width="1px" padding="6px 0 8px" />
        <mj-text align="center" padding="0" color="#A9B8D0" font-size="11px" font-weight="600" letter-spacing="1.8px" line-height="1.4">FLORIDA FOOTBALL ALL THE TIME. · OLD SCHOOL JOURNALISM. NEW TECH.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="26px 28px 4px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 8px" color="#D8450C" font-size="13px" font-weight="800" letter-spacing="2px" line-height="1.2">FLORIDA FOOTBALL</mj-text>
        <mj-text padding="0 0 12px" color="#081B35" font-size="38px" font-weight="800" line-height="1.06" letter-spacing="-0.3px" css-class="gz-headline"><a href="https://www.gatorbaitmedia.com/magazine?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=headline" style="color:#081B35;text-decoration:none;">Florida 34, Vanderbilt 27: The GatorBait Postgame Magazine</a></mj-text>
        <mj-text padding="0 0 14px" color="#5F6B7A" font-size="13px" font-weight="700" letter-spacing="1px" line-height="1.3">BY GATORBAIT MEDIA</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0">
      <mj-column>
        <mj-image src="https://static.wixstatic.com/media/d3cfa5_3379423180ca4b8d9e937998d84fa338~mv2.jpg" alt="A Florida player in a blue No. 13 jersey stands in the end zone as fans behind him cheer and raise their arms at Ben Hill Griffin Stadium, Nov. 21, 2026. Photo by Chris Spears, GatorBait Media." href="https://www.gatorbaitmedia.com/magazine?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=cover" padding="0" fluid-on-mobile="true" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="7px 28px 0" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0" color="#6B7686" font-size="12px" line-height="1.35" css-class="gz-credit">A Florida player in a blue No. 13 jersey stands in the end zone as fans behind him cheer and raise their arms at Ben Hill Griffin Stadium, Nov. 21, 2026. Photo by Chris Spears, GatorBait Media.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="18px 28px 6px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 18px" color="#27364F" font-size="19px" line-height="1.5">Florida came from 24-17 down at the half to beat Vanderbilt on Senior Day. The game story, the columns, the box score, how the game swung and what Jon Sumrall said afterward, all in one place.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/magazine?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=open_magazine" align="left" padding="0 0 8px" width="100%">OPEN THE MAGAZINE &#8594;</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 28px 6px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 10px" color="#D8450C" font-size="13px" font-weight="800" letter-spacing="2px" line-height="1.2">IN THIS ISSUE</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 28px 8px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 3px" color="#5F6B7A" font-size="12px" font-weight="700" letter-spacing="1px" line-height="1.3">GATORBAIT STAFF · GAME STORY</mj-text>
        <mj-text padding="0 0 4px" color="#081B35" font-size="20px" font-weight="800" line-height="1.18"><a href="https://www.gatorbaitmedia.com/post/baugh-control-no-24-florida-rallies-past-vanderbilt-34-27-on-senior-day?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=game_story" style="color:#081B35;text-decoration:none;">Baugh Control: No. 24 Florida rallies past Vanderbilt 34-27 on Senior Day</a></mj-text>
        <mj-text padding="0 0 6px" color="#27364F" font-size="16px" line-height="1.45">Jadan Baugh's 10-yard run with 2:18 left finished the comeback from a 24-17 halftime deficit.</mj-text>
        <mj-divider border-color="#D5DCE6" border-width="1px" padding="6px 0 0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 28px 8px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 3px" color="#5F6B7A" font-size="12px" font-weight="700" letter-spacing="1px" line-height="1.3">BUDDY MARTIN · COLUMN</mj-text>
        <mj-text padding="0 0 4px" color="#081B35" font-size="20px" font-weight="800" line-height="1.18"><a href="https://www.gatorbaitmedia.com/post/some-days-you-need-your-gator-fortune-cookie-to-crumble-your-way-it-did?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=buddy_fortune" style="color:#081B35;text-decoration:none;">Some Days You Need Your Gator Fortune Cookie to Crumble Your Way. It Did.</a></mj-text>
        <mj-text padding="0 0 6px" color="#27364F" font-size="16px" line-height="1.45">Two breaks, a helmet on the turf and a tipped ball.</mj-text>
        <mj-divider border-color="#D5DCE6" border-width="1px" padding="6px 0 0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 28px 8px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 3px" color="#5F6B7A" font-size="12px" font-weight="700" letter-spacing="1px" line-height="1.3">FRANZ BEARD · COLUMN</mj-text>
        <mj-text padding="0 0 4px" color="#081B35" font-size="20px" font-weight="800" line-height="1.18"><a href="https://www.gatorbaitmedia.com/post/no-logic-no-reason-just-a-bizarre-florida-win?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=franz_bizarre" style="color:#081B35;text-decoration:none;">No logic, no reason, just a bizarre Florida win</a></mj-text>
        <mj-text padding="0 0 6px" color="#27364F" font-size="16px" line-height="1.45">A lucky bounce, a helmet on the turf and a last-minute sack, plus the SEC scoreboard.</mj-text>
        <mj-divider border-color="#D5DCE6" border-width="1px" padding="6px 0 0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 28px 8px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 3px" color="#5F6B7A" font-size="12px" font-weight="700" letter-spacing="1px" line-height="1.3">BUDDY MARTIN · COLUMN</mj-text>
        <mj-text padding="0 0 4px" color="#081B35" font-size="20px" font-weight="800" line-height="1.18"><a href="https://www.gatorbaitmedia.com/post/jon-sumrall-says-it-s-time-for-gator-football-to-say-thanks?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=buddy_thanks" style="color:#081B35;text-decoration:none;">Jon Sumrall Says It's Time for Gator Football to Say Thanks.</a></mj-text>
        <mj-text padding="0 0 6px" color="#27364F" font-size="16px" line-height="1.45">Gratitude, barbecue and a 7-4 team headed to Tallahassee.</mj-text>
        <mj-divider border-color="#D5DCE6" border-width="1px" padding="6px 0 0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 28px 8px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 3px" color="#5F6B7A" font-size="12px" font-weight="700" letter-spacing="1px" line-height="1.3">EDDIE GILLEY · AREA EVALUATIONS</mj-text>
        <mj-text padding="0 0 4px" color="#081B35" font-size="20px" font-weight="800" line-height="1.18"><a href="https://www.gatorbaitmedia.com/post/area-evaluations-florida-vs-vanderbilt?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=eddie_areas" style="color:#081B35;text-decoration:none;">Area Evaluations: Florida vs. Vanderbilt</a></mj-text>
        <mj-text padding="0 0 6px" color="#27364F" font-size="16px" line-height="1.45">The weather, the turf, the cleats and the atmosphere in the Swamp, graded.</mj-text>
        <mj-divider border-color="#D5DCE6" border-width="1px" padding="6px 0 0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 28px 8px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 3px" color="#5F6B7A" font-size="12px" font-weight="700" letter-spacing="1px" line-height="1.3">GATORBAIT STAFF · REACTION</mj-text>
        <mj-text padding="0 0 4px" color="#081B35" font-size="20px" font-weight="800" line-height="1.18"><a href="https://www.gatorbaitmedia.com/post/sumrall-after-the-comeback-we-are-a-train-wreck-at-times?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=reaction" style="color:#081B35;text-decoration:none;">Sumrall after the comeback: 'We are a train wreck at times'</a></mj-text>
        <mj-text padding="0 0 6px" color="#27364F" font-size="16px" line-height="1.45">What Jon Sumrall, Aaron Philo and Myles Graham said after the win.</mj-text>
        <mj-divider border-color="#D5DCE6" border-width="1px" padding="6px 0 0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 28px 8px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 3px" color="#5F6B7A" font-size="12px" font-weight="700" letter-spacing="1px" line-height="1.3">GATORBAIT STAFF · RECEIVERS</mj-text>
        <mj-text padding="0 0 4px" color="#081B35" font-size="20px" font-weight="800" line-height="1.18"><a href="https://www.gatorbaitmedia.com/post/seven-games-without-vb3-and-still-no-word-on-a-return?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=receivers" style="color:#081B35;text-decoration:none;">The Receiving Room Keeps Answering</a></mj-text>
        <mj-text padding="0 0 6px" color="#27364F" font-size="16px" line-height="1.45">Eric Singleton Jr. had 117 yards against Vanderbilt.</mj-text>
        <mj-divider border-color="#D5DCE6" border-width="1px" padding="6px 0 0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 28px 8px" css-class="gz-pad">
      <mj-column>
        <mj-text padding="0 0 3px" color="#5F6B7A" font-size="12px" font-weight="700" letter-spacing="1px" line-height="1.3">CHRIS SPEARS · PHOTOS</mj-text>
        <mj-text padding="0 0 4px" color="#081B35" font-size="20px" font-weight="800" line-height="1.18"><a href="https://www.gatorbaitmedia.com/post/chris-spears-best-shots-florida-34-vanderbilt-27?utm_source=gatorbait_gazette_alert&#38;utm_medium=email&#38;utm_campaign=postgame_magazine&#38;utm_content=gallery" style="color:#081B35;text-decoration:none;">Chris Spears' Best Shots: Florida 34, Vanderbilt 27</a></mj-text>

    <mj-section background-color="#0B1F4B" padding="20px 24px 26px" border-left="6px solid #FA4616" css-class="gb-pad">
      <mj-column>
        <mj-text align="left" padding="0 0 6px" color="#FF8A5C" font-size="13px" font-weight="800" letter-spacing="2px">THE COVER STORY &#183; FRANZ BEARD</mj-text>
        <mj-text css-class="gb-h1" align="left" padding="0 0 10px" color="#FFFFFF" font-size="36px" font-weight="800" line-height="1.08"><a href="https://www.gatorbaitmedia.com/post/why-i-despise-the-georgia-bulldogs-and-why-you-should-too-2?utm_source=newsletter&utm_medium=email&utm_campaign=magazine_fl_ga_2026_10_30&utm_content=cover_headline" style="color:#FFFFFF;text-decoration:none;">WHY I DESPISE THE GEORGIA BULLDOGS AND WHY YOU SHOULD TOO</a></mj-text>
        <mj-text align="left" padding="0 0 16px" color="#D5DBE4" font-size="17px">Franz Beard&#8217;s annual rivalry column. Florida faces Georgia in Atlanta on Saturday.</mj-text>
        <mj-button align="left" href="https://www.gatorbaitmedia.com/post/why-i-despise-the-georgia-bulldogs-and-why-you-should-too-2?utm_source=newsletter&utm_medium=email&utm_campaign=magazine_fl_ga_2026_10_30&utm_content=cover_button">READ THE COLUMN</mj-button>
        <mj-text align="left" padding="14px 0 0" color="#8FA0BE" font-size="11px">Cover photo: archive photo by Chris Spears, GatorBait Media.</mj-text>
      </mj-column>
    </mj-section>

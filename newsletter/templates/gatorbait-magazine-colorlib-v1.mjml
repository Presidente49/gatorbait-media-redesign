    <!-- Cover -->
    <mj-section background-color="#081B35" padding="0">
      <mj-column>
        <mj-image src="https://static.wixstatic.com/media/a99769_9cea463d1045446d8550ce6aa803b0d3~mv2.jpeg"
          alt="Jadan Baugh celebrates a touchdown at Auburn. Photo by Chris Spears / GatorBait Media."
          padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#081B35" padding="24px 30px 28px">
      <mj-column>
        <mj-text color="#FA7A45" font-size="10px" font-weight="900" letter-spacing="1.9px" padding="0 0 8px">
          THE BUDDY MARTIN COLUMN · COVER STORY
        </mj-text>
        <mj-text color="#FFFFFF" padding="0 0 10px">
          <span class="gb-h1">The Swamp Knows Something the Big Ten Doesn’t</span>
        </mj-text>
        <mj-text color="#D5DFEC" font-size="16px" line-height="1.55" padding="0 0 15px">
          Florida–Ole Miss is a national-stage game in Gainesville. Buddy Martin writes about The Swamp, the SEC and what Saturday can say about the Gators.
        </mj-text>
        <mj-text color="#9EADC1" font-size="10px" padding="0 0 14px">
          Jadan Baugh at Auburn · Photo by Chris Spears / GatorBait Media
        </mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/the-swamp-knows-something-the-big-ten-doesnt?utm_source=gatorbait_magazine_newsletter&#38;utm_medium=email&#38;utm_campaign=ole_miss_week_2026_09_25&#38;utm_content=buddy_swamp_lead" align="left" padding="0">
          READ BUDDY’S COLUMN →
        </mj-button>
      </mj-column>
    </mj-section>


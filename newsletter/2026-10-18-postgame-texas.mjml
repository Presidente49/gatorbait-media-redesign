<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Gators stun No. 7 Texas 27-24 in Austin</mj-title>
    <mj-preview>Florida scored 24 straight after trailing 17-3. Columns, box score and more from around the program.</mj-preview>
    <mj-font name="Barlow" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Barlow, Arial, Helvetica, sans-serif" />
      <mj-text color="#33404F" font-size="17px" line-height="1.5" padding="0 0 14px" />
      <mj-button background-color="#FA4616" color="#FFFFFF" border-radius="0" inner-padding="16px 28px" font-size="18px" font-weight="800" letter-spacing="0.8px" align="left" padding="0" />
    </mj-attributes>
    <mj-style>
      :root { color-scheme: light; supported-color-schemes: light; }
      @media only screen and (max-width: 480px) {
        .gb-pad { padding-left: 16px !important; padding-right: 16px !important; }
        .gb-h1 div { font-size: 32px !important; }

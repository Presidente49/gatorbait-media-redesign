        <mj-text align="center" padding="0" color="#0B1F4B" font-size="40px" font-weight="800" line-height="1.1">27</mj-text>
        <mj-text align="center" padding="0" color="#5B6472" font-size="14px">7-1 &#183; 5-1 SEC</mj-text>
      </mj-column>

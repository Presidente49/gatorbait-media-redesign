# Copy only to ~/.fcc/.env on the local machine. Never commit real secrets.

HOST=127.0.0.1
PORT=8082
FCC_OPEN_BROWSER=true
MESSAGING_PLATFORM=none

# Mandatory for GatorBait.
PROXY_AUTH_ENABLED=true
ANTHROPIC_AUTH_TOKEN=REPLACE_WITH_RANDOM_LOCAL_TOKEN

# Public-work pilot defaults. Provider keys are added locally in FCC Admin.
MODEL=open_router/openrouter/free
# Optional fallbacks after those providers are configured:
# MODEL_FALLBACKS=groq/llama-3.3-70b-versatile,nvidia_nim/nvidia/nemotron-3-super-120b-a12b

# Provider keys are intentionally omitted from this tracked template.
# OPENROUTER_API_KEY=
# NVIDIA_NIM_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

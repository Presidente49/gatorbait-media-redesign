<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>{{issue.title}}</mj-title>
    <mj-preview>{{issue.preheader}}</mj-preview>
    <mj-font name="Barlow" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800;900&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Barlow, Arial, Helvetica, sans-serif" />
      <mj-text color="#14243D" font-size="15px" line-height="1.55" />
      <mj-button background-color="#FA4616" color="#FFFFFF" border-radius="0" inner-padding="12px 18px" font-size="12px" font-weight="800" />
      <mj-class name="kicker" font-size="10px" font-weight="800" letter-spacing="1.7px" color="#D8450C" text-transform="uppercase" />
      <mj-class name="meta" font-size="10px" color="#6D7888" letter-spacing="1px" text-transform="uppercase" />
    </mj-attributes>
    <mj-style>
      .gb-wordmark { font-weight:900; letter-spacing:-1.8px; }
      .gb-h1 { font-family:'Barlow',Arial,Helvetica,sans-serif; font-size:37px; line-height:1.04; font-weight:700; letter-spacing:-.6px; }
      .gb-h2 { font-family:'Barlow',Arial,Helvetica,sans-serif; font-size:23px; line-height:1.14; font-weight:700; }
      .gb-h3 { font-family:'Barlow',Arial,Helvetica,sans-serif; font-size:19px; line-height:1.18; font-weight:700; }
      .gb-rule { border-top:3px solid #FA4616; }
      @media only screen and (max-width:480px) {
        .gb-h1 { font-size:31px !important; line-height:1.08 !important; }
        .gb-h2 { font-size:21px !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F2F0EB" width="640px">

    <!-- Masthead -->
    <mj-section background-color="#FFFFFF" padding="22px 24px 8px">
      <mj-column width="22%">
        <mj-text color="#003B7A" font-size="9px" line-height="1.45" font-weight="800" letter-spacing="2px" padding="8px 0 0">
          FLORIDA<br/>FOOTBALL<br/>ALL THE TIME.
        </mj-text>
      </mj-column>
      <mj-column width="56%">
        <mj-text align="center" padding="0">
          <span class="gb-wordmark" style="font-size:36px;color:#003B7A;">GATOR</span><span class="gb-wordmark" style="font-size:36px;color:#FA4616;">BAIT</span><br/>
          <span style="font-size:13px;font-weight:800;letter-spacing:3px;color:#003B7A;">MEDIA</span>
        </mj-text>
        <mj-divider border-color="#FA4616" border-width="3px" width="54%" padding="7px 0 5px" />
        <mj-text align="center" color="#003B7A" font-size="10px" font-weight="800" letter-spacing="2.2px" padding="0">
          GATORBAIT MAGAZINE NEWSLETTER
        </mj-text>
      </mj-column>
      <mj-column width="22%">
        <mj-text align="right" color="#003B7A" font-size="9px" line-height="1.45" font-weight="800" letter-spacing="1.8px" padding="8px 0 0">
          OLD SCHOOL<br/>JOURNALISM.<br/>NEW TECH.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 24px 18px">
      <mj-column>
        <mj-text align="center" color="#5F6B7A" font-size="10px" font-weight="700" letter-spacing="1.7px" padding="0">
          {{issue.dateline}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Cover -->
    <mj-section background-color="#081B35" padding="0">
      <mj-column>
        <mj-image src="{{lead.image}}"
          alt="{{lead.alt}}"
          padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#081B35" padding="24px 30px 28px">
      <mj-column>
        <mj-text color="#FA7A45" font-size="10px" font-weight="900" letter-spacing="1.9px" padding="0 0 8px">
          {{lead.kicker}}
        </mj-text>
        <mj-text color="#FFFFFF" padding="0 0 10px">
          <span class="gb-h1">{{lead.title}}</span>
        </mj-text>
        <mj-text color="#D5DFEC" font-size="16px" line-height="1.55" padding="0 0 15px">
          {{lead.excerpt}}
        </mj-text>
        <mj-text color="#9EADC1" font-size="10px" padding="0 0 14px">
          {{lead.credit}}
        </mj-text>
        <mj-button href="{{lead.url}}" align="left" padding="0">
          {{lead.cta}}
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Two-column game file -->
    <mj-section background-color="#FFFDF9" padding="28px 26px 8px">
      <mj-column>
        <mj-text color="#081B35" font-size="25px" font-weight="800" padding="0 0 5px">
          {{game_file.title}}
        </mj-text>
        <mj-divider border-color="#081B35" border-width="2px" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFDF9" padding="8px 20px 28px">
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="kicker" padding="0 0 6px">{{game_file.0.kicker}}</mj-text>
        <mj-text padding="0 0 7px"><span class="gb-h2">{{game_file.0.title}}</span></mj-text>
        <mj-text color="#5F6B7A" font-size="13px" padding="0 0 11px">
          {{game_file.0.excerpt}}
        </mj-text>
        <mj-button href="{{game_file.0.url}}" align="left" padding="0">
          {{game_file.0.cta}}
        </mj-button>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="kicker" padding="0 0 6px">{{game_file.1.kicker}}</mj-text>
        <mj-text padding="0 0 7px"><span class="gb-h2">{{game_file.1.title}}</span></mj-text>
        <mj-text color="#5F6B7A" font-size="13px" padding="0 0 11px">
          {{game_file.1.excerpt}}
        </mj-text>
        <mj-button href="{{game_file.1.url}}" align="left" padding="0">
          {{game_file.1.cta}}
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Second serious photo -->
    <mj-section background-color="#E9EEF5" padding="0">
      <mj-column>
        <mj-image src="{{feature.image}}"
          alt="{{feature.alt}}"
          padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#E9EEF5" padding="18px 28px 24px">
      <mj-column>
        <mj-text mj-class="kicker" padding="0 0 7px">{{feature.kicker}}</mj-text>
        <mj-text padding="0 0 7px"><span class="gb-h2">{{feature.title}}</span></mj-text>
        <mj-text color="#4D5B70" padding="0 0 11px">
          {{feature.excerpt}}
        </mj-text>
        <mj-text color="#748195" font-size="10px" padding="0 0 12px">
          {{feature.credit}}
        </mj-text>
        <mj-button href="{{feature.url}}" align="left" padding="0">
          {{feature.cta}}
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Text-led editorial grid -->
    <mj-section background-color="#FFFFFF" padding="27px 26px 8px">
      <mj-column>
        <mj-text color="#081B35" font-size="24px" font-weight="800" padding="0 0 5px">INSIDE THIS ISSUE</mj-text>
        <mj-divider border-color="#FA4616" border-width="3px" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="8px 20px 20px">
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="meta" padding="12px 0 5px">{{inside.0.author}}</mj-text>
        <mj-text padding="0 0 6px"><span class="gb-h3">{{inside.0.title}}</span></mj-text>
        <mj-text color="#5F6B7A" font-size="13px" padding="0 0 10px">{{inside.0.excerpt}}</mj-text>
        <mj-button href="{{inside.0.url}}" align="left" padding="0">{{inside.0.cta}}</mj-button>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="meta" padding="12px 0 5px">{{inside.1.author}}</mj-text>
        <mj-text padding="0 0 6px"><span class="gb-h3">{{inside.1.title}}</span></mj-text>
        <mj-text color="#5F6B7A" font-size="13px" padding="0 0 10px">{{inside.1.excerpt}}</mj-text>
        <mj-button href="{{inside.1.url}}" align="left" padding="0">{{inside.1.cta}}</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 20px 28px">
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="meta" padding="12px 0 5px">{{inside.2.author}}</mj-text>
        <mj-text padding="0 0 6px"><span class="gb-h3">{{inside.2.title}}</span></mj-text>
        <mj-text color="#5F6B7A" font-size="13px" padding="0 0 10px">{{inside.2.excerpt}}</mj-text>
        <mj-button href="{{inside.2.url}}" align="left" padding="0">{{inside.2.cta}}</mj-button>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="meta" padding="12px 0 5px">{{inside.3.author}}</mj-text>
        <mj-text padding="0 0 6px"><span class="gb-h3">{{inside.3.title}}</span></mj-text>
        <mj-text color="#5F6B7A" font-size="13px" padding="0 0 10px">{{inside.3.excerpt}}</mj-text>
        <mj-button href="{{inside.3.url}}" align="left" padding="0">{{inside.3.cta}}</mj-button>
      </mj-column>
    </mj-section>

    <!-- Utility strip -->
    <mj-section background-color="#003B7A" padding="20px 18px">
      <mj-column width="33.33%" padding="0 6px">
        <mj-button href="{{utilities.0.url}}" background-color="#FA4616" padding="0">{{utilities.0.cta}}</mj-button>
      </mj-column>
      <mj-column width="33.33%" padding="0 6px">
        <mj-button href="{{utilities.1.url}}" background-color="#FA4616" padding="0">{{utilities.1.cta}}</mj-button>
      </mj-column>
      <mj-column width="33.33%" padding="0 6px">
        <mj-button href="{{utilities.2.url}}" background-color="#FA4616" padding="0">{{utilities.2.cta}}</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="20px 26px 24px">
      <mj-column width="38%">
        <mj-text padding="0" color="#003B7A" font-size="19px" font-weight="900">
          GATOR<span style="color:#FA4616;">BAIT</span> MEDIA
        </mj-text>
      </mj-column>
      <mj-column width="62%">
        <mj-text align="right" color="#667386" font-size="11px" line-height="1.55" padding="0">
          Florida football. All the time.<br/>
          GatorBaitMedia.com · Old-school journalism + new tech.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

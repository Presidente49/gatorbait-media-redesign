    <mj-section background-color="#FFFFFF" padding="0 24px 8px" css-class="gb-pad">
      <mj-column>
        <mj-image src="https://static.wixstatic.com/media/d3cfa5_9757cdda175141a595ad34d51439d9c6~mv2.jpg/v1/fill/w_1040,h_585,al_c,q_80/file.jpg" alt="Aaron Philo and Jon Sumrall on the Florida sideline. Photo by Chris Spears, GatorBait Media." href="https://www.gatorbaitmedia.com/post/the-gators-sucked-less-turning-arch-madness-into-arch-sadness?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=sunday_photo" padding="0 0 12px" />
        <mj-text padding="0 0 8px" color="#101820" font-size="26px" font-weight="800" line-height="1.15"><a href="https://www.gatorbaitmedia.com/post/the-gators-sucked-less-turning-arch-madness-into-arch-sadness?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=sunday_headline" style="color:#101820;text-decoration:none;">The Gators Sucked Less, Turning Arch Madness Into Arch Sadness</a></mj-text>
        <mj-text padding="0 0 6px" color="#5B6472" font-size="14px">By Franz Beard</mj-text>
        <mj-text padding="0 0 14px">A bye week, a quarterback question and a defense that found its fight in Austin. Plus every SEC result from Saturday.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/the-gators-sucked-less-turning-arch-madness-into-arch-sadness?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=sunday_button">READ THE COLUMN</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#F5F6F8" padding="22px 24px 14px" css-class="gb-pad">
      <mj-column>
        <mj-text padding="0 0 4px" color="#C23A0E" font-size="13px" font-weight="800" letter-spacing="1.6px">AROUND THE SEC</mj-text>
        <mj-table padding="0 0 8px" cellpadding="0" cellspacing="0" width="100%" font-size="16px">
          <tr><td style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#101820;font-size:16px;font-weight:700;">Auburn 27, No. 1 Georgia 24</td><td align="right" style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#5B6472;font-size:14px;">Upset in Athens</td></tr>
          <tr><td style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#101820;font-size:16px;font-weight:700;">No. 14 Tennessee 26, No. 6 Alabama 10</td><td align="right" style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#5B6472;font-size:14px;">Vols sack Russell 5 times</td></tr>
          <tr><td style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#101820;font-size:16px;font-weight:700;">No. 9 Ole Miss 31, No. 13 Missouri 3</td><td align="right" style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#5B6472;font-size:14px;">Rebels dominate</td></tr>
          <tr><td style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#101820;font-size:16px;font-weight:700;">No. 15 Kentucky 21, Oklahoma 13</td><td align="right" style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#5B6472;font-size:14px;">Sooners out of the CFP chase</td></tr>
          <tr><td style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#101820;font-size:16px;font-weight:700;">No. 22 LSU 31, No. 16 Mississippi State 0</td><td align="right" style="padding:10px 0;border-bottom:1px solid #E6E9EF;color:#5B6472;font-size:14px;">Leavitt 31-of-38</td></tr>

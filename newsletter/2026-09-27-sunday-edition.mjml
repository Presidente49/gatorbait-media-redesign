<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>GatorBait Magazine — Sunday Edition: Florida Jumps to No. 8</mj-title>
    <mj-preview>Florida is 4-0 (2-0 SEC) and No. 8 in both the AP Top 25 and the Coaches Poll after its first top-five win since 2020. Next: at No. 25 Missouri, Saturday, Oct. 3, 3:30 p.m. ET.</mj-preview>
    <mj-font name="Newsreader" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,600;6..72,700&amp;display=swap" />
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text color="#14243D" font-size="15px" line-height="1.55" />
      <mj-button background-color="#FA4616" color="#FFFFFF" border-radius="0" inner-padding="12px 18px" font-size="12px" font-weight="800" />
      <mj-class name="kicker" font-size="10px" font-weight="800" letter-spacing="1.7px" color="#D8450C" text-transform="uppercase" />
    </mj-attributes>
    <mj-style>
      .gb-wordmark { font-weight:900; letter-spacing:-1.8px; }
      .gb-h1 { font-family:'Newsreader',Georgia,serif; font-size:32px; line-height:1.08; font-weight:700; }
      .gb-h2 { font-family:'Newsreader',Georgia,serif; font-size:24px; line-height:1.14; font-weight:700; }
      .gb-h3 { font-family:'Newsreader',Georgia,serif; font-size:19px; line-height:1.2; font-weight:700; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F2F0EB" width="640px">
    <mj-section background-color="#FFFFFF" padding="20px 24px 14px">
      <mj-column>
        <mj-text align="center" padding="0"><a href="https://www.gatorbaitmedia.com/?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=masthead" style="text-decoration:none;"><span class="gb-wordmark" style="font-size:34px;color:#003B7A;">GATOR</span><span class="gb-wordmark" style="font-size:34px;color:#FA4616;">BAIT</span></a><br/><span style="font-size:10px;font-weight:800;letter-spacing:2.2px;color:#003B7A;">GATORBAIT MAGAZINE NEWSLETTER</span></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#081B35" padding="18px 22px 8px">
      <mj-column>
        <mj-text align="center" color="#FA7A45" font-size="10px" font-weight="900" letter-spacing="2px" padding="0 0 4px">FINAL · Saturday, Sept. 26 · 3:30 p.m. ET · ABC</mj-text>
        <mj-table padding="0" width="100%"><tr>
        <td style="padding:10px 4px;text-align:center;"><div style="font:800 15px/1.2 Inter,Arial,sans-serif;color:#D5DFEC;">Ole Miss</div><div style="font:700 10px/1.4 Inter,Arial,sans-serif;color:#9EADC1;letter-spacing:1px;">NO. 4 · 3-1</div><div style="font:700 44px/1.1 Newsreader,Georgia,serif;color:#FFFFFF;">28</div></td>
        <td style="padding:10px 4px;text-align:center;color:#9EADC1;font:700 11px/1.4 Inter,Arial,sans-serif;">Ben Hill Griffin Stadium</td>
        <td style="padding:10px 4px;text-align:center;"><div style="font:800 15px/1.2 Inter,Arial,sans-serif;color:#FFFFFF;">Florida</div><div style="font:700 10px/1.4 Inter,Arial,sans-serif;color:#9EADC1;letter-spacing:1px;">NO. 21 · 4-0</div><div style="font:700 44px/1.1 Newsreader,Georgia,serif;color:#FFFFFF;">52</div></td>
        </tr></mj-table>
        <mj-text align="center" color="#FFFFFF" padding="8px 0 4px"><span class="gb-h1">FINAL: Florida 52, No. 4 Ole Miss 28</span></mj-text>
        <mj-text align="center" color="#D5DFEC" font-size="15px" padding="0 0 16px">Florida is 4-0 (2-0 SEC) and No. 8 in both the AP Top 25 and the Coaches Poll after its first top-five win since 2020. Next: at No. 25 Missouri, Saturday, Oct. 3, 3:30 p.m. ET.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFDF9" padding="18px 26px 8px">
      <mj-column>
        <mj-text color="#081B35" font-size="20px" font-weight="800" padding="0 0 6px">GAME TRACKER</mj-text>
        <mj-table width="100%" padding="0" font-size="14px">
          <tr style="border-bottom:2px solid #081B35;font-size:11px;font-weight:800;letter-spacing:1px;"><th style="text-align:left;padding:6px 4px;color:#6D7888;">OLE MISS</th><th></th><th style="text-align:right;padding:6px 4px;color:#003B7A;">FLORIDA</th></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;">426</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">Total yards</td><td style="text-align:right;padding:8px 4px;font-weight:800;">498</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;">128</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">Rushing</td><td style="text-align:right;padding:8px 4px;font-weight:800;">302</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;">4-11</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">3rd down</td><td style="text-align:right;padding:8px 4px;font-weight:800;">6-10</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;">2</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">Turnovers</td><td style="text-align:right;padding:8px 4px;font-weight:800;">0</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;">23:01</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">Possession</td><td style="text-align:right;padding:8px 4px;font-weight:800;">36:59</td></tr>
        </mj-table>
        <mj-text font-size="13px" color="#4B5666" padding="10px 0 0"><b>Leaders:</b> Baugh 29-142, 3 TD · Clark 12-126, TD · Philo 16/23, 196, TD · Montgomery 3 KR, 128 yds</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="22px 26px 0">
      <mj-column><mj-text color="#081B35" font-size="20px" font-weight="800" padding="0 0 4px">THE STORIES</mj-text><mj-divider border-color="#FA4616" border-width="3px" padding="0" /></mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="22px 26px 18px">
      <mj-column>
        <mj-image src="https://static.wixstatic.com/media/d3cfa5_1043f4b7772245baa5aed5f80c21669a~mv2.png" alt="Chomp up the charts: Florida is No. 8 in the AP Top 25 and the Coaches Poll. Jon Sumrall leads the Gators onto the field. Photo by Chris Spears, GatorBait Media." href="https://www.gatorbaitmedia.com/post/chomp-up-the-charts-florida-jumps-to-no-8-in-ap-coaches-polls?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_no_8_in_both_polls" padding="0 0 12px" />
        <mj-text mj-class="kicker" padding="0 0 4px">No. 8 in both polls</mj-text>
        <mj-text padding="0 0 6px"><a href="https://www.gatorbaitmedia.com/post/chomp-up-the-charts-florida-jumps-to-no-8-in-ap-coaches-polls?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_no_8_in_both_polls" style="color:#081B35;text-decoration:none;"><span class="gb-h2">Chomp Up the Charts: Florida Jumps to No. 8 in AP, Coaches Polls</span></a></mj-text>
        <mj-text font-size="14px" color="#4B5666" padding="0 0 10px">Florida’s 52-28 win over No. 4 Ole Miss sent the Gators up 13 spots in the AP Top 25 and 14 in the Coaches Poll. They’re No. 8 in both.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/chomp-up-the-charts-florida-jumps-to-no-8-in-ap-coaches-polls?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_no_8_in_both_polls" align="left" padding="0">READ →</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="6px 26px 18px">
      <mj-column>
        <mj-image src="https://static.wixstatic.com/media/d3cfa5_026d2a4d2be04a91b8c32317fed5f623~mv2.jpg" alt="Jadan Baugh dives for his first touchdown against Ole Miss in The Swamp. Photo by Chris Spears, GatorBait Media." href="https://www.gatorbaitmedia.com/post/bound-for-the-cfb-top-ten-cue-up-happy-days-are-here-again?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_buddy_martin" padding="0 0 12px" />
        <mj-text mj-class="kicker" padding="0 0 4px">Buddy Martin</mj-text>
        <mj-text padding="0 0 6px"><a href="https://www.gatorbaitmedia.com/post/bound-for-the-cfb-top-ten-cue-up-happy-days-are-here-again?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_buddy_martin" style="color:#081B35;text-decoration:none;"><span class="gb-h3">Bound for the CFB Top Ten: Cue Up “Happy Days Are Here Again”</span></a></mj-text>
        <mj-text font-size="14px" color="#4B5666" padding="0 0 10px">Florida’s updated ESPN FPI projections now have the Gators favored in every remaining game except Texas and Georgia. That math comes out to 10-2 and a ticket to the playoff.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/bound-for-the-cfb-top-ten-cue-up-happy-days-are-here-again?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_buddy_martin" align="left" padding="0">READ →</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="6px 26px 18px">
      <mj-column>
        <mj-text mj-class="kicker" padding="0 0 4px">Chris Spears</mj-text>
        <mj-text padding="0 0 6px"><a href="https://www.gatorbaitmedia.com/post/chris-spears-10-thoughts-from-the-sidelines-florida-ole-miss?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_chris_spears" style="color:#081B35;text-decoration:none;"><span class="gb-h3">10 Thoughts From the Sidelines: Florida 52, Ole Miss 28</span></a></mj-text>
        <mj-text font-size="14px" color="#4B5666" padding="0 0 10px">Photographer Chris Spears had the best seat in The Swamp. Ten things the sideline told him about the Florida team that ran over No. 4 Ole Miss.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/chris-spears-10-thoughts-from-the-sidelines-florida-ole-miss?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_chris_spears" align="left" padding="0">READ →</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="6px 26px 18px">
      <mj-column>
        <mj-text mj-class="kicker" padding="0 0 4px">Franz Beard</mj-text>
        <mj-text padding="0 0 6px"><a href="https://www.gatorbaitmedia.com/post/franz-beard-gators-left-28-points-on-the-field-ole-miss?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_franz_beard" style="color:#081B35;text-decoration:none;"><span class="gb-h3">Beating Ole Miss was huge, but the Gators left at least 28 points on the field</span></a></mj-text>
        <mj-text font-size="14px" color="#4B5666" padding="0 0 10px">Florida beat No. 4 Ole Miss 52-28, but Franz Beard counts at least 28 points the Gators left on the field: an overthrown Vernell Brown III, an open Amir Jackson on fourth down, a 67-yard touchdown erased by a hold, and…</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/franz-beard-gators-left-28-points-on-the-field-ole-miss?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_franz_beard" align="left" padding="0">READ →</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="6px 26px 18px">
      <mj-column>
        <mj-text mj-class="kicker" padding="0 0 4px">Loren Meadows</mj-text>
        <mj-text padding="0 0 6px"><a href="https://www.gatorbaitmedia.com/post/postgame-analysis-florida-gators-52-ole-miss-rebel-28?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_loren_meadows" style="color:#081B35;text-decoration:none;"><span class="gb-h3">Postgame Analysis: Florida Gators 52, Ole Miss Rebels 28</span></a></mj-text>
        <mj-text font-size="14px" color="#4B5666" padding="0 0 10px">Florida dominated No. 4 Ole Miss for a season-defining win, but Jon Sumrall says the Gators are still a work in progress. Loren Meadows on what he expected, what he got and what comes next.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/postgame-analysis-florida-gators-52-ole-miss-rebel-28?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_loren_meadows" align="left" padding="0">READ →</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="6px 26px 18px">
      <mj-column>
        <mj-text mj-class="kicker" padding="0 0 4px">Carlton Reese</mj-text>
        <mj-text padding="0 0 6px"><a href="https://www.gatorbaitmedia.com/post/carlton-reese-florida-contenders-not-hopefuls-ole-miss?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_carlton_reese" style="color:#081B35;text-decoration:none;"><span class="gb-h3">Contenders, Not Hopefuls: Florida’s Rout of No. 4 Ole Miss Puts the SEC on Notice</span></a></mj-text>
        <mj-text font-size="14px" color="#4B5666" padding="0 0 10px">Carlton Reese: With a 52-28 thrashing of No. 4 Ole Miss, Jon Sumrall’s Gators are no longer hoping to compete. They are a legitimate contender.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/carlton-reese-florida-contenders-not-hopefuls-ole-miss?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_carlton_reese" align="left" padding="0">READ →</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="6px 26px 18px">
      <mj-column>
        <mj-text mj-class="kicker" padding="0 0 4px">Game story</mj-text>
        <mj-text padding="0 0 6px"><a href="https://www.gatorbaitmedia.com/post/florida-ole-miss-final-baugh-gators-run-over-rebels?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_game_story" style="color:#081B35;text-decoration:none;"><span class="gb-h3">Baugh Game: Gators Run Over No. 4 Ole Miss 52-28 in The Swamp</span></a></mj-text>
        <mj-text font-size="14px" color="#4B5666" padding="0 0 10px">Jadan Baugh ran for three touchdowns, Florida scored touchdowns on its first five possessions of the second half, and No. 21 Florida beat No. 4 Ole Miss 52-28 to move to 4-0.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/florida-ole-miss-final-baugh-gators-run-over-rebels?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=sunday_edition_2026_09_27&utm_content=band_game_story" align="left" padding="0">READ →</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FA4616" padding="20px 26px">
      <mj-column>
        <mj-text color="#FFFFFF" font-size="10px" font-weight="900" letter-spacing="1.9px" padding="0 0 6px">LOOK AHEAD</mj-text>
        <mj-text color="#FFFFFF" padding="0 0 6px"><span class="gb-h2">No. 8 Florida at No. 25 Missouri</span></mj-text>
        <mj-text color="#FFF1EA" font-size="14px" padding="0">Saturday, Oct. 3 · 3:30 p.m. ET · Columbia, Mo. The Gators are 4-0 (2-0 SEC).</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="18px 26px 24px">
      <mj-column width="40%"><mj-text padding="0" color="#003B7A" font-size="18px" font-weight="900">GATOR<span style="color:#FA4616;">BAIT</span> MEDIA</mj-text></mj-column>

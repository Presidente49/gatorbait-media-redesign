    <mj-section background-color="#FFFFFF" padding="12px 24px 28px" css-class="gb-pad">
      <mj-column>
        <mj-text align="left" padding="0 0 10px" color="#6B7280" font-size="11px">Photo by Chris Spears, GatorBait Media</mj-text>
        <mj-text align="left" padding="0 0 4px" color="#C23A0E" font-size="12px" font-weight="800" letter-spacing="1.6px">GATORBAIT STAFF &#183; OCT. 30</mj-text>
        <mj-text align="left" padding="0 0 8px" color="#101820" font-size="28px" font-weight="800" line-height="1.15"><a href="https://www.gatorbaitmedia.com/post/florida-philo-jones-questionable-georgia-sec-availability-report?utm_source=newsletter&utm_medium=email&utm_campaign=magazine_fl_ga_2026_10_30&utm_content=philo_headline" style="color:#101820;text-decoration:none;">Georgia-Born Gator: Reports Say Aaron Philo Will Start Against Georgia</a></mj-text>
        <mj-text align="left" padding="0 0 14px" font-size="16px">CBS Sports and The Associated Press report that Florida plans to start Aaron Philo against Georgia in Atlanta, though the Gators had not made a formal public announcement as of Friday.</mj-text>
        <mj-button align="left" href="https://www.gatorbaitmedia.com/post/florida-philo-jones-questionable-georgia-sec-availability-report?utm_source=newsletter&utm_medium=email&utm_campaign=magazine_fl_ga_2026_10_30&utm_content=philo_button">READ THE REPORT</mj-button>
      </mj-column>
    </mj-section>

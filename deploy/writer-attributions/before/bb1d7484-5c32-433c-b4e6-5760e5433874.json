            "nodes": [],
            "textData": {
              "text": "By Buddy Martin",
              "decorations": [
                {
                  "type": "BOLD",
                  "fontWeightValue": 700
                }
              ]
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {

mri-grade-1-pcl-sprain-florida-gators', until: Date.parse('2026-09-28T16:00:00Z') };\n    var breaking = Date.now() < BREAKING.until ? posts.find(function(p) { return p.url.indexOf(BREAKING.path) >= 0; }) : null;\n    var PIN = { path: '/post/who-are-these-guys-trautwein-s-troops-in-the-trenches-are-difference-makers', until: Date.parse('2026-10-05T16:00:00Z') };\n    var pinned = Date.now() < PIN.until ? posts.find(function(p) { return p.url.indexOf(PIN.path) >= 0; }) : null;\n    if (pinned && buddy && buddy.date > pinned.date) pinned = null;\n    var lead = breaking || pinned || buddy || posts[0];\n    var others = posts.filter(function(p) { return p.url !== lead.url; });\n    var supporting = others.slice(0,2);\n    // Owner direction: no story appears twice on the front page. Each rail takes the newest unshown stories.\n    var shown = {}; shown[lead.url] = 1; supporting.forEach(function(p) { shown[p.url] = 1; });\n    function unseen(list, n) { var out = []; list.forEach(function(p) { if (out.length < n && !shown[p.url]) { shown[p.url] = 1; out.push(p); } }); return out; }\n    var latest = unseen(others, 6);\n    function link(p, content, cls) { return '<a class=\"' + (cls || '') + '\" href=\"' + esc(p.url) + '\">' + content + '</a>'; }\n    function meta(p) { return '<p class=\"sh-meta\">' + esc(p.author) + ' · ' + esc(dateLabel(p.date)) + '</p>'; }\n    function photo(p, eager) { return p.image ? '<img src=\"' + esc(p.image) + '\" alt=\"' + esc(p.alt) + '\" loading=\"' + (eager ? 'eager' : 'lazy') + '\" decoding=\"async\"' + (eager ? ' fetchpriority=\"high\"' : '') + '>' : ''; }\n    function item(p) { return '<article class=\"sh-wire-item\">' + link(p, photo(p, false) + meta(p) + '<h3>' + esc(p.title) + '</h3>') + '</article>'; }\n    function support(p) { return '<article>' + link(p, photo(p, false) + meta(p) + '<h2>' + esc(p.title) + '</h2>') + '</article>'; }\n    function column(name) { var p = unseen(posts.filter(function(p) { return p.author.toLowerC
<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>GatorBait Magazine — Florida vs Ole Miss</mj-title>
    <mj-preview>Buddy Martin leads the Florida–Ole Miss game-week edition from GatorBait Magazine.</mj-preview>

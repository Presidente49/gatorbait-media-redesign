          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;font-weight:800;">27</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">First downs</td><td style="text-align:right;padding:8px 4px;">25</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;font-weight:800;">6-10</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">3rd down</td><td style="text-align:right;padding:8px 4px;">4-11</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;">0-1</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">4th down</td><td style="text-align:right;padding:8px 4px;">1-2</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;font-weight:800;">0</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">Turnovers</td><td style="text-align:right;padding:8px 4px;">2</td></tr>
          <tr style="border-bottom:1px solid #E1E4EA;"><td style="padding:8px 4px;font-weight:800;">36:59</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">Possession</td><td style="text-align:right;padding:8px 4px;">23:01</td></tr>
          <tr><td style="padding:8px 4px;">8-92</td><td style="text-align:center;padding:8px 4px;color:#6D7888;font-size:12px;">Penalties-yards</td><td style="text-align:right;padding:8px 4px;">8-69</td></tr>

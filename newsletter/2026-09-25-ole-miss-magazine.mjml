    <mj-section background-color="#FFFFFF" padding="26px 24px 8px">
      <mj-column>
        <mj-text color="#FA4616" font-size="11px" font-weight="900" letter-spacing="1.7px" padding="0 0 9px">THE BUDDY MARTIN COLUMN · COVER STORY</mj-text>
        <mj-text color="#081F3D" font-size="35px" line-height="1.07" font-weight="900" padding="0 0 12px">The Swamp Knows Something the Big Ten Doesn’t</mj-text>
        <mj-text color="#4B586A" font-size="18px" line-height="1.48" padding="0 0 20px">Buddy Martin on Florida–Ole Miss, The Swamp’s home-field edge and the SEC’s chance to challenge the Big Ten’s championship run.</mj-text>
        <mj-image src="https://static.wixstatic.com/media/d3cfa5_b8996f468d7c4c1cb4c359d4288b8196~mv2.png" alt="Editorial illustration: SEC and Big Ten championship rivalry at The Swamp" width="650px" padding="0" />
        <mj-button href="https://www.gatorbaitmedia.com/post/the-swamp-knows-something-the-big-ten-doesnt?utm_source=gatorbait_magazine_newsletter" padding="20px 0 22px">READ BUDDY’S COLUMN</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="8px 24px 4px">
      <mj-column width="50%" padding="0 10px 0 0">

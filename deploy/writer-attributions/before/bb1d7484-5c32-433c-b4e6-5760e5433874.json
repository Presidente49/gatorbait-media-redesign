        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "The whole first half, it felt like Florida was about to break out and blow Ole Miss off the map.",
              "decorations": [
                {
                  "type": "BOLD",
                  "fontWeightValue": 700
                }
              ]
            }
          }
        ],
        "paragraphData": {}
      },
      {

    <mj-section background-color="#FFFFFF" padding="22px 26px 18px">
      <mj-column>
        <mj-image src="https://static.wixstatic.com/media/16b519_a0e407bedc46487ca71033fc8351d0fe~mv2.jpg" alt="The Florida sideline erupts in celebration against Ole Miss. Photo by Chris Spears, GatorBait Media." href="https://www.gatorbaitmedia.com/post/chris-spears-best-shots-vol-2-florida-52-ole-miss-28?utm_source=gatorbait_magazine_newsletter&utm_medium=email&utm_campaign=roundup_2026_09_28&utm_content=best_shots_vol_2" padding="0 0 12px" />
        <mj-text mj-class="kicker" padding="0 0 4px">Chris Spears</mj-text>

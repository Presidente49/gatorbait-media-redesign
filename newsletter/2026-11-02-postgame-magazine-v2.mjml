    <mj-section background-color="#FA4616" padding="9px 24px" css-class="gb-pad">
      <mj-column>
        <mj-text align="center" padding="0" color="#FFFFFF" font-size="13px" font-weight="800" letter-spacing="2px">POSTGAME EDITION &#183; GEORGIA 27, FLORIDA 8</mj-text>

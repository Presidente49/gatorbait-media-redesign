<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-style>:root { color-scheme: light dark; supported-color-schemes: light dark; }</mj-style>
    <mj-title>GatorBait Magazine — Florida vs Ole Miss</mj-title>
    <mj-preview>The serious Florida–Ole Miss game-week edition from GatorBait Magazine.</mj-preview>
    <mj-font name="Newsreader" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600;6..72,700&amp;display=swap" />
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text color="#26364d" font-size="15px" line-height="1.6" />
      <mj-button background-color="#FA4616" color="#ffffff" border-radius="0" inner-padding="11px 18px" font-weight="700" font-size="12px" />
      <mj-class name="serif" font-family="Newsreader, Georgia, serif" />
      <mj-class name="kicker" font-size="10px" text-transform="uppercase" letter-spacing="0.16em" color="#FA4616" font-weight="700" />
      <mj-class name="meta" font-size="11px" text-transform="uppercase" letter-spacing="0.08em" color="#7b8796" />
    </mj-attributes>
    <mj-style>
      a { color:#0021A5; text-decoration:none; }
      .gb-h1 { font-family:'Newsreader',Georgia,serif; font-size:36px; line-height:1.08; font-weight:700; color:#081F3D; letter-spacing:-.01em; }
      .gb-h2 { font-family:'Newsreader',Georgia,serif; font-size:23px; line-height:1.16; font-weight:700; color:#081F3D; }
      .gb-card { border-top:1px solid #dfe3e8; padding-top:16px; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f4f5f3" width="640px">
    <mj-section background-color="#081F3D" padding="28px 38px 20px">
      <mj-column width="68%">
        <mj-text color="#ffffff" font-size="27px" font-weight="800" letter-spacing="-0.6px" padding="0">GATORBAIT</mj-text>
        <mj-text color="#FA4616" font-size="10px" font-weight="700" letter-spacing="2px" padding="5px 0 0">MAGAZINE NEWSLETTER</mj-text>
      </mj-column>
      <mj-column width="32%">
        <mj-text align="right" color="#cbd5e1" font-size="10px" letter-spacing="1px" padding="4px 0 0">OLE MISS WEEK<br/>SEPTEMBER 2026</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#fffdf9" padding="18px 38px 0">
      <mj-column><mj-divider border-color="#FA4616" border-width="3px" padding="0" /></mj-column>
    </mj-section>

    <mj-section background-color="#fffdf9" padding="30px 38px 10px">
      <mj-column>
        <mj-text mj-class="kicker" padding="0 0 10px">THE BUDDY MARTIN COLUMN · COVER STORY</mj-text>
        <mj-text padding="0 0 9px"><span class="gb-h1">The Swamp Knows Something the Big Ten Doesn’t</span></mj-text>
        <mj-text color="#5d6877" font-size="17px" line-height="1.5" padding="0 0 18px">Florida–Ole Miss is a national-stage game in Gainesville. Buddy Martin writes about The Swamp, the SEC and what Saturday can say about the Gators.</mj-text>
        <mj-image src="https://static.wixstatic.com/media/a99769_9cea463d1045446d8550ce6aa803b0d3~mv2.jpeg" alt="Jadan Baugh celebrates a touchdown at Auburn. Photo by Chris Spears / GatorBait Media." padding="0 0 6px" />
        <mj-text color="#7b8796" font-size="10px" padding="0 0 14px">Jadan Baugh at Auburn · Photo by Chris Spears / GatorBait Media</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/the-swamp-knows-something-the-big-ten-doesnt?utm_source=gatorbait_magazine_newsletter&#38;utm_medium=email&#38;utm_campaign=ole_miss_week_2026_09_25&#38;utm_content=buddy_swamp_lead" align="left" padding="0 0 18px">READ BUDDY’S COLUMN</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#fffdf9" padding="12px 28px 26px">
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="kicker" padding="0 0 7px">GAME PLAN</mj-text>
        <mj-text padding="0 0 8px"><span class="gb-h2">Keep the Ball Away From Trinidad Chambliss</span></mj-text>
        <mj-text color="#657181" font-size="13px" padding="0 0 11px">Franz Beard on how Florida’s run game can control the clock and the matchup against No. 4 Ole Miss.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/the-best-way-for-the-gators-to-win-is-keep-the-ball-away-from-trinidad-chambliss?utm_source=gatorbait_magazine_newsletter&#38;utm_medium=email&#38;utm_campaign=ole_miss_week_2026_09_25&#38;utm_content=chambliss_analysis" align="left" padding="0">READ THE ANALYSIS</mj-button>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text mj-class="kicker" padding="0 0 7px">GAME WEEK REFERENCE</mj-text>
        <mj-text padding="0 0 8px"><span class="gb-h2">Florida Roster &amp; Injury Watch</span></mj-text>
        <mj-text color="#657181" font-size="13px" padding="0 0 11px">Eric Singleton Jr., Ole Miss availability, Florida’s roster snapshot and the updated 2026 schedule.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/florida-gators-2026-roster-and-schedule-update-auburn-opens-sec-play?utm_source=gatorbait_magazine_newsletter&#38;utm_medium=email&#38;utm_campaign=ole_miss_week_2026_09_25&#38;utm_content=roster_injury_guide" align="left" padding="0">OPEN THE GUIDE</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#eef1f4" padding="28px 38px 8px">
      <mj-column>
        <mj-text mj-class="kicker" padding="0 0 8px">INSIDE THE OFFENSE</mj-text>
        <mj-image src="https://static.wixstatic.com/media/16b519_a0c1b7e3ce9846239402069349deab8c~mv2.jpg" alt="Aaron Philo runs for a first down against Auburn. Photo by Chris Spears / GatorBait Media." padding="0 0 7px" />
        <mj-text color="#7b8796" font-size="10px" padding="0 0 12px">Aaron Philo at Auburn · Photo by Chris Spears / GatorBait Media</mj-text>
        <mj-text padding="0 0 8px"><span class="gb-h2">Buster Faulkner’s Offense Is Anything But Predictable</span></mj-text>
        <mj-text color="#5f6c7b" padding="0 0 13px">Franz Beard breaks down the calls, trust and wrinkles driving Florida’s early offensive surge.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/buster-faulkner-s-offense-is-anything-but-predictable?utm_source=gatorbait_magazine_newsletter&#38;utm_medium=email&#38;utm_campaign=ole_miss_week_2026_09_25&#38;utm_content=buster_offense" align="left" padding="0 0 18px">GO INSIDE THE OFFENSE</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#fffdf9" padding="28px 28px 6px">
      <mj-column><mj-text color="#081F3D" font-size="12px" font-weight="800" letter-spacing="1.5px" padding="0 10px 12px">INSIDE THIS ISSUE</mj-text></mj-column>
    </mj-section>

    <mj-section background-color="#fffdf9" padding="0 28px 20px">
      <mj-column width="50%" padding="0 10px">
        <mj-text css-class="gb-card" mj-class="meta" padding="15px 0 6px">FRANZ BEARD</mj-text>
        <mj-text padding="0 0 7px"><span class="gb-h2">Thoughts of the Day</span></mj-text>
        <mj-text color="#657181" font-size="13px" padding="0 0 10px">Kerwin Bell, Aaron Philo and a few thoughts to start the day.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/thoughts-of-the-day-september-22-2027?utm_source=gatorbait_magazine_newsletter&#38;utm_medium=email&#38;utm_campaign=ole_miss_week_2026_09_25&#38;utm_content=thoughts_of_day" align="left" padding="0">READ THOUGHTS</mj-button>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text css-class="gb-card" mj-class="meta" padding="15px 0 6px">EDDIE GILLEY</mj-text>
        <mj-text padding="0 0 7px"><span class="gb-h2">5 Signs Sumrall’s Gators Are Rising</span></mj-text>
        <mj-text color="#657181" font-size="13px" padding="0 0 10px">What Florida’s 44-39 win at Auburn revealed about the line, the edge and the penalty problem.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/florida-after-auburn-5-signs-sumrall-gators-rising?utm_source=gatorbait_magazine_newsletter&#38;utm_medium=email&#38;utm_campaign=ole_miss_week_2026_09_25&#38;utm_content=five_signs" align="left" padding="0">READ THE FIVE SIGNS</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#fffdf9" padding="0 28px 26px">
      <mj-column width="50%" padding="0 10px">
        <mj-text css-class="gb-card" mj-class="meta" padding="15px 0 6px">BUDDY MARTIN</mj-text>
        <mj-text padding="0 0 7px"><span class="gb-h2">Sumrall Stayed Home. So Did His Star Running Back.</span></mj-text>
        <mj-text color="#657181" font-size="13px" padding="0 0 10px">The Christmas Eve visit that helped keep Jadan Baugh at Florida.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/jon-sumrall-stayed-home-so-did-his-star-running-back-it-was-a-brilliant-choice?utm_source=gatorbait_magazine_newsletter&#38;utm_medium=email&#38;utm_campaign=ole_miss_week_2026_09_25&#38;utm_content=sumrall_baugh" align="left" padding="0">READ BUDDY</mj-button>
      </mj-column>
      <mj-column width="50%" padding="0 10px">
        <mj-text css-class="gb-card" mj-class="meta" padding="15px 0 6px">NEW COLUMN</mj-text>
        <mj-text padding="0 0 7px"><span class="gb-h2">The Cowboy Doesn’t Talk Very Often</span></mj-text>
        <mj-text color="#657181" font-size="13px" padding="0 0 10px">Buddy on Aaron Philo’s toughness and quiet confidence. Text only here — no repeated or novelty image.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/the-cowboy-doesn-t-talk-very-often-but-his-actions-speak-even-louder?utm_source=gatorbait_magazine_newsletter&#38;utm_medium=email&#38;utm_campaign=ole_miss_week_2026_09_25&#38;utm_content=cowboy_text_only" align="left" padding="0">READ THE COLUMN</mj-button>

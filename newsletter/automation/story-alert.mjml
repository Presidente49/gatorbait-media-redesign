<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>${title}</mj-title>
    <mj-preview>${description}</mj-preview>
    <mj-font name="Newsreader" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600;6..72,700&amp;display=swap" />
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text color="#14243D" font-size="16px" line-height="1.55" />
      <mj-button background-color="#FA4616" color="#FFFFFF" border-radius="0" inner-padding="14px 22px" font-size="13px" font-weight="800" />
    </mj-attributes>
    <mj-style>
      .gb-wordmark { font-weight:900; letter-spacing:-1.8px; }
      .gb-h1 { font-family:'Newsreader',Georgia,serif; font-size:34px; line-height:1.08; font-weight:700; letter-spacing:-.4px; }
      @media only screen and (max-width:480px) {
        .gb-h1 { font-size:28px !important; line-height:1.12 !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F2F0EB" width="640px">

    <!-- Alert bar -->
    <mj-section background-color="#FA4616" padding="10px 24px">
      <mj-column>
        <mj-text color="#FFFFFF" font-size="13px" font-weight="900" letter-spacing="3px" padding="0">GATORBAIT NEWS ALERT</mj-text>
      </mj-column>
    </mj-section>

    <!-- Masthead -->
    <mj-section background-color="#FFFFFF" padding="16px 24px 12px">
      <mj-column>
        <mj-text align="center" padding="0">
          <a href="https://www.gatorbaitmedia.com/?utm_source=gatorbait_story_alert&amp;utm_medium=email&amp;utm_campaign=story_alert&amp;utm_content=masthead" style="text-decoration:none;"><span class="gb-wordmark" style="font-size:32px;color:#003B7A;">GATOR</span><span class="gb-wordmark" style="font-size:32px;color:#FA4616;">BAIT</span></a><br/>
          <span style="font-size:12px;font-weight:800;letter-spacing:3px;color:#003B7A;">MEDIA</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Cover -->
    <mj-section background-color="#081B35" padding="0">
      <mj-column>
        <mj-image src="${coverImageUrl}" alt="${title}" href="${url}?utm_source=gatorbait_story_alert&amp;utm_medium=email&amp;utm_campaign=story_alert&amp;utm_content=cover_image" padding="0" width="640px" />
      </mj-column>
    </mj-section>

    <!-- Story -->
    <mj-section background-color="#FFFFFF" padding="26px 30px 8px">
      <mj-column>
        <mj-text padding="0 0 14px" color="#081B35"><span class="gb-h1">${title}</span></mj-text>
        <mj-text padding="0 0 20px">${description}</mj-text>
        <mj-button href="${url}?utm_source=gatorbait_story_alert&amp;utm_medium=email&amp;utm_campaign=story_alert&amp;utm_content=read_full_story" align="left" padding="0 0 26px">READ THE FULL STORY</mj-button>
      </mj-column>
    </mj-section>

    <!-- More -->
    <mj-section background-color="#081B35" padding="20px 30px">
      <mj-column width="62%">
        <mj-text color="#FA7A45" font-size="11px" font-weight="900" letter-spacing="2px" padding="0 0 6px">MORE FROM GATORBAIT</mj-text>
        <mj-text color="#D5DFEC" font-size="14px" line-height="1.5" padding="0 0 12px">Florida football, all the time. Buddy Martin, Franz Beard and the GatorBait crew on every story that matters.</mj-text>
      </mj-column>
      <mj-column width="38%">
        <mj-button href="https://www.gatorbaitmedia.com/?utm_source=gatorbait_story_alert&amp;utm_medium=email&amp;utm_campaign=story_alert&amp;utm_content=homepage" align="right" padding="4px 0 0" background-color="#FFFFFF" color="#081B35">LATEST NEWS</mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#FFFFFF" padding="18px 26px 22px">
      <mj-column width="40%">
        <mj-text padding="0" color="#003B7A" font-size="18px" font-weight="900">GATOR<span style="color:#FA4616;">BAIT</span> MEDIA</mj-text>
      </mj-column>
      <mj-column width="60%">
        <mj-text align="right" color="#667386" font-size="11px" line-height="1.55" padding="0">GatorBaitMedia.com · Old-school journalism + new tech.<br/>1524 SE 22nd Ave, Ocala, FL 34471</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

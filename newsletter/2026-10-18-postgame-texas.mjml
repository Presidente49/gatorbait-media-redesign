  <mj-body background-color="#FFFFFF" width="600px">
    <mj-section background-color="#0B1F4B" padding="22px 24px 16px" border-top="6px solid #FA4616" css-class="gb-pad">
      <mj-column>
        <mj-text css-class="gb-mast" align="center" padding="0 0 4px" color="#FFFFFF" font-size="44px" font-weight="800" letter-spacing="4px" line-height="1">GATOR<span style="color:#FA4616;">BAIT</span></mj-text>
        <mj-text align="center" padding="0 0 10px" color="#D5DBE4" font-size="13px" font-weight="700" letter-spacing="5px">MAGAZINE</mj-text>
        <mj-divider border-color="#FA4616" border-width="2px" padding="0 0 10px" />
        <mj-text align="center" padding="0" color="#FFFFFF" font-size="14px" font-weight="700" letter-spacing="2px">POSTGAME EDITION &#183; SUNDAY, OCT. 18, 2026 &#183; FLORIDA AT TEXAS</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0" css-class="gb-pad0">
      <mj-column>
        <mj-image src="https://static.wixstatic.com/media/d3cfa5_be419eb42b8f4aa883f5596690c79e0c~mv2.jpg/v1/fill/w_1200,h_675,al_c,q_80/file.jpg" alt="Photo for Gators Stun No. 7 Texas 27-24 in Austin Behind Jones Jr." href="https://www.gatorbaitmedia.com/post/gators-stun-no-7-texas-27-24-in-austin-behind-jones-jr?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=lead_photo" padding="0" fluid-on-mobile="true" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="20px 24px 26px" css-class="gb-pad">
      <mj-column>
        <mj-text padding="0 0 4px" color="#C23A0E" font-size="13px" font-weight="800" letter-spacing="1.6px">FINAL &#183; SATURDAY, OCT. 17 &#183; AUSTIN</mj-text>
        <mj-text css-class="gb-h1" padding="0 0 8px" color="#101820" font-size="38px" font-weight="800" line-height="1.08"><a href="https://www.gatorbaitmedia.com/post/gators-stun-no-7-texas-27-24-in-austin-behind-jones-jr?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=lead_headline" style="color:#101820;text-decoration:none;">Gators Stun No. 7 Texas 27-24 in Austin Behind Jones Jr.</a></mj-text>
        <mj-text padding="0 0 12px" color="#5B6472" font-size="14px">By Brenden Martin</mj-text>
        <mj-text>Florida trailed 17-3, then scored 24 straight points and left DKR-Texas Memorial Stadium with a 27-24 win over No. 7 Texas. The Gators are 5-2 overall and 3-2 in the SEC.</mj-text>
        <mj-text padding="0 0 20px">Tramell Jones Jr. threw for two touchdowns and ran for 41 yards, Jadan Baugh ran for 91 yards and a score, and Florida did not turn the ball over.</mj-text>
        <mj-button href="https://www.gatorbaitmedia.com/post/gators-stun-no-7-texas-27-24-in-austin-behind-jones-jr?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=lead_button" font-size="18px" inner-padding="16px 28px">READ THE GAME STORY</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#0B1F4B" padding="22px 24px 14px" css-class="gb-pad">
      <mj-column>
        <mj-text padding="0 0 6px" color="#FFAD86" font-size="13px" font-weight="800" letter-spacing="2px">INSIDE THIS ISSUE</mj-text>
        <mj-table padding="0 0 6px" cellpadding="0" cellspacing="0" width="100%"><tr><td width="44" valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;color:#FA4616;font-size:22px;font-weight:800;">01</td><td valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;"><a href="https://www.gatorbaitmedia.com/post/gators-stun-no-7-texas-27-24-in-austin-behind-jones-jr?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=toc_1" style="color:#FFFFFF;text-decoration:none;font-size:17px;font-weight:800;line-height:1.2;">Gators Stun No. 7 Texas, 27-24</a><br /><span style="color:#B8C2D6;font-size:13px;">The game story &#183; Brenden Martin</span></td></tr><tr><td width="44" valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;color:#FA4616;font-size:22px;font-weight:800;">02</td><td valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;"><a href="https://www.gatorbaitmedia.com/post/it-was-a-good-day-for-an-exorcism-in-austin?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=toc_2" style="color:#FFFFFF;text-decoration:none;font-size:17px;font-weight:800;line-height:1.2;">It was a good day for an exorcism in Austin</a><br /><span style="color:#B8C2D6;font-size:13px;">Franz Beard</span></td></tr><tr><td width="44" valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;color:#FA4616;font-size:22px;font-weight:800;">03</td><td valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;"><a href="https://www.gatorbaitmedia.com/post/a-texas-barbecue-gators-flip-the-script-and-jones-changes-the-conversation?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=toc_3" style="color:#FFFFFF;text-decoration:none;font-size:17px;font-weight:800;line-height:1.2;">A Texas Barbecue: Gators Flip The Script</a><br /><span style="color:#B8C2D6;font-size:13px;">Buddy Martin</span></td></tr><tr><td width="44" valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;color:#FA4616;font-size:22px;font-weight:800;">04</td><td valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;"><a href="https://www.gatorbaitmedia.com/post/the-gators-sucked-less-turning-arch-madness-into-arch-sadness?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=toc_4" style="color:#FFFFFF;text-decoration:none;font-size:17px;font-weight:800;line-height:1.2;">The Gators Sucked Less, Turning Arch Madness Into Arch Sadness</a><br /><span style="color:#B8C2D6;font-size:13px;">Franz Beard &#183; Plus every SEC result</span></td></tr><tr><td width="44" valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;color:#FA4616;font-size:22px;font-weight:800;">05</td><td valign="top" style="padding:10px 0;border-bottom:1px solid #2B4278;"><a href="https://www.gatorbaitmedia.com/post/gators-stun-no-7-texas-27-24-in-austin-behind-jones-jr?utm_source=newsletter&utm_medium=email&utm_campaign=postgame_2026_10_18&utm_content=toc_5" style="color:#FFFFFF;text-decoration:none;font-size:17px;font-weight:800;line-height:1.2;">Box score, standouts and what&#8217;s next</a><br /><span style="color:#B8C2D6;font-size:13px;">Georgia, Oct. 31 on ABC</span></td></tr></mj-table>

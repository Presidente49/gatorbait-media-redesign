        <mj-text padding="0 0 4px" color="#C23A0E" font-size="13px" font-weight="800" letter-spacing="1.6px">STANDOUTS</mj-text>
        <mj-table padding="0 0 20px" cellpadding="0" cellspacing="0" width="100%" font-size="16px"><tr><td style="padding:11px 12px 11px 0;border-bottom:1px solid #E6E9EF;color:#101820;font-size:16px;font-weight:700;" valign="top">Tramell Jones Jr.</td><td align="right" style="padding:11px 0;border-bottom:1px solid #E6E9EF;color:#33404F;font-size:15px;line-height:1.35;">22-of-35, 155 yards, 2 TDs passing;<br />10 carries, 41 yards</td></tr><tr><td style="padding:11px 12px 11px 0;border-bottom:1px solid #E6E9EF;color:#101820;font-size:16px;font-weight:700;" valign="top">Jadan Baugh</td><td align="right" style="padding:11px 0;border-bottom:1px solid #E6E9EF;color:#33404F;font-size:15px;line-height:1.35;">25 carries, 91 yards, 1 TD</td></tr><tr><td style="padding:11px 12px 11px 0;border-bottom:1px solid #E6E9EF;color:#101820;font-size:16px;font-weight:700;" valign="top">Lacota Dippre</td><td align="right" style="padding:11px 0;border-bottom:1px solid #E6E9EF;color:#33404F;font-size:15px;line-height:1.35;">2 touchdown catches</td></tr><tr><td style="padding:11px 12px 11px 0;border-bottom:1px solid #E6E9EF;color:#101820;font-size:16px;font-weight:700;" valign="top">Patrick Durkin</td><td align="right" style="padding:11px 0;border-bottom:1px solid #E6E9EF;color:#33404F;font-size:15px;line-height:1.35;">2-of-2 on field goals (45, 28 yards)</td></tr></mj-table>

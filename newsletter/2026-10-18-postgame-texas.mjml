ing:11px 4px;font-size:16px;color:#33404F;">0</td><td align="center" style="padding:11px 4px;font-size:16px;color:#33404F;">7</td><td align="center" style="padding:11px 0;font-size:22px;font-weight:800;color:#101820;">24</td></tr></mj-table>

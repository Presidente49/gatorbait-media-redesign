      },
      {
        "type": "PARAGRAPH",
        "id": "byline1",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "By GatorBait Media Staff",
              "decorations": [
                {
                  "type": "ITALIC",
                  "italicData": true
                }
              ]
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "p0",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "The SEC office took a long look at Florida's 52-28 rout of No. 4 Ole Miss and handed out hardware to three Gators on Monday.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "p1",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Running back Jadan Baugh was named SEC Offensive Player of the Week, kick returner London Montgomery was named Special Teams Player of the Week and left tackle Bryce Lovett was named Offensive Lineman of the Week. It's the first career SEC weekly honor for all three.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "HEADING",
        "id": "h2",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Baugh keeps rolling",
              "decorations": []
            }
          }
        ],
        "headingData": {
          "level": 3
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "p3",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Baugh ran 29 times for 142 yards and three touchdowns against the Rebels and caught one pass for 12 yards. It was his fifth straight 100-yard rushing game, according to UF.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "p4",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "He led all FBS players with 11 rushing first downs in Week 4, and UF credited him with 103 yards after contact. Baugh has run for at least 135 yards and multiple touchdowns in all four games this season.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "p5",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "The junior leads the FBS in rushing touchdowns (11) and scoring. His 600 rushing yards are the most by a Gator through the first four games, according to UF.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "HEADING",
        "id": "h6",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Montgomery flips the field",
              "decorations": []
            }
          }
        ],
        "headingData": {
          "level": 3
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "p7",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Montgomery returned three kickoffs for 128 yards, an average of 42.7 per return. One kick after a 41-yard return in the third quarter, he broke a career-long 74-yarder.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "p8",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "It was Florida's longest kickoff return since Solomon Patton went 100 yards at Missouri in 2013, according to UF, and Montgomery's 128 return yards are the most by an SEC player in a game this season.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "p9",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Jon Sumrall said Monday he nearly told the return team to take a touchback after an earlier miscue. “And then I was like, you know, I want to see London hit one,” he said.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "HEADING",
        "id": "h10",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Lovett locks down the edge",
              "decorations": []
            }
          }
        ],
        "headingData": {
          "level": 3
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "p11",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Lovett, making his fourth straight start at left tackle, played 69 snaps and did not allow a quarterback pressure or hurry, according to UF. He posted an 85.1 Pro Football Focus pass-blocking grade.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "p12",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Up front, Florida ran for 302 yards on 53 carries with six rushing touchdowns and did not allow a sack. It was the Gators' highest rushing total against an SEC opponent since they ran for 374 against South Carolina on Nov. 11, 2022.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "p13",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "No. 8 Florida (4-0, 2-0 SEC) plays at No. 25 Missouri on Saturday, Oct. 3, at 3:30 p.m. ET on ABC.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      }
    ]
  },

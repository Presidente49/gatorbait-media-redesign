    <mj-section background-color="#FFFFFF" padding="26px 24px 28px" css-class="gb-pad">
      <mj-column>
        <mj-text align="left" padding="0 0 6px" color="#101820" font-size="22px" font-weight="800" line-height="1.3">Real Gator news for real Gators.</mj-text>
        <mj-text align="left" padding="0 0 16px" font-size="16px">News you can count on. If you ain&#8217;t a Gator, you must be GatorBait. Join for every column and the Magazine.</mj-text>

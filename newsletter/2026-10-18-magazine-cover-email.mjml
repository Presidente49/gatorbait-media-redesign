  <mj-head>
    <mj-title>GatorBait Magazine: Postgame Edition. Florida 27, No. 7 Texas 24</mj-title>
    <mj-preview>The cover, the columns and the clips from Austin. Read the Postgame Edition.</mj-preview>
    <mj-font name="Barlow" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Barlow, Arial, Helvetica, sans-serif" />
      <mj-text color="#33404F" font-size="17px" line-height="1.5" padding="0 0 14px" />
      <mj-button background-color="#FA4616" color="#FFFFFF" border-radius="0" inner-padding="18px 32px" font-size="19px" font-weight="800" letter-spacing="0.8px" align="center" padding="0" />
    </mj-attributes>
    <mj-style>
      :root { color-scheme: light; supported-color-schemes: light; }
      @media only screen and (max-width: 480px) {
        .gb-pad { padding-left: 16px !important; padding-right: 16px !important; }
        .gb-h2 div { font-size: 24px !important; }

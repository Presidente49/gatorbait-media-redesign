<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>GatorBait Magazine — Thursday Edition: Faulkner, Woods and Aberdeen</mj-title>
    <mj-preview>Buddy Martin on Buster Faulkner, Jayden Woods' Bednarik Award nod, Pay the Toll, SEC honors for Baugh and more before Saturday's trip to Missouri.</mj-preview>
    <mj-font name="Newsreader" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,600;6..72,700&amp;display=swap" />
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&amp;display=swap" />

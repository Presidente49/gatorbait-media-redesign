                  }
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": ".",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": []
      },
      {
        "type": "HEADING",
        "id": "",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Injury watch: Wednesday’s report",
              "decorations": []
            }
          }
        ],
        "headingData": {
          "level": 2
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": []
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Florida — Questionable: WR Eric Singleton Jr. (ankle). He was the only Gator listed on the Wednesday report. That does not establish that every player is completely healthy or guarantee Saturday participation.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": []
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Ole Miss — Questionable: RB Kewan Lacy, CB Cedrick Beavers, S MJ Preston and S Craig Tutt.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": []
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Ole Miss — Out: CB Dorian Barney, CB Victor Lincoln Jr., LB Ant Davis Jr., LB JaMichael Garrett, OL Jalan Chapman and OL Emanuel Faulkner.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": []
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Lacy is dealing with a shoulder injury after leaving the Rebels’ 32-24 win over LSU. He rushed for 1,567 yards and 24 touchdowns last season. His status is significant to Florida’s preparation, but the Gators cannot build their plan around an assumption that he will sit.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": []
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "“He’s a game changer,” Florida defensive coordinator Brad White said of Lacy, according to the Gainesville Sun. White said Florida was preparing for Lacy to be ready.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": []
      },
      {
        "type": "PARAGRAPH",
        "id": "",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Availability source: ",
              "decorations": []
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Swamp247’s complete Wednesday report",
              "decorations": [
                {
                  "type": "LINK",
                  "linkData": {
                    "link": {
                      "url": "https://247sports.com/college/florida/article/florida-football-week-4-availability-report-wednesday-eric-singleton-290351707/",
                      "target": "BLANK"
                    }
                  }
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": ". These designations can change before kickoff.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {}
      },
